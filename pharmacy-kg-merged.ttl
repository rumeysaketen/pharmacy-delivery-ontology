pdo:containMedicine a owl:ObjectProperty ;
    rdfs:domain pdo:Order ;
    rdfs:range pdo:Medicine ;
    rdfs:subPropertyOf owl:topObjectProperty .

pdo:deliveredBy a owl:ObjectProperty ;
    rdfs:domain pdo:Order ;
    rdfs:range pdo:DeliveryPerson ;
    rdfs:subPropertyOf owl:topObjectProperty .

pdo:placesOrder a owl:ObjectProperty ;
    rdfs:domain pdo:User ;
    rdfs:range pdo:Order ;
    rdfs:subPropertyOf owl:topObjectProperty .

pdo:providedBy a owl:ObjectProperty ;
    rdfs:domain pdo:Medicine ;
    rdfs:range pdo:Pharmacy ;
    rdfs:subPropertyOf owl:topObjectProperty .

pdo:requiresPrescription a owl:ObjectProperty ;
    rdfs:domain pdo:Medicine ;
    rdfs:range pdo:Prescription ;
    rdfs:subPropertyOf owl:topObjectProperty .

